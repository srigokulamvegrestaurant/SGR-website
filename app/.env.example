# ==============================================================================
# SRI GOKULAM VEG RESTAURANT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BASE URL
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://srigokulam.com
APP_SECRET=	8e9b4c2a71f053e1987d65c4b3a2019f

# ------------------------------------------------------------------------------
# 2. SUPABASE & POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# Provided Supabase project endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. REAL SMS & EMAIL OTP DISPATCH (Replace console simulation)
# ------------------------------------------------------------------------------
# Fast2SMS (India Domestic DLT SMS Gateway)
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=SRIGOK
FAST2SMS_DLT_TE_ID=your_dlt_template_id

# Or Twilio SMS Gateway
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Transactional Email Dispatch (Resend or Nodemailer SMTP)
RESEND_API_KEY=re_your_resend_api_key
# Alternatively:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=srigokulamvegrestaurant@gmail.com
SMTP_PASS=juaz swpa azpc uyys
SMTP_FROM_NAME="Sri Gokulam Veg Restaurant"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY PROVIDER (Production & Sandbox Webhook Verification)
# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PhonePe PG
PHONEPE_MERCHANT_ID=M22...
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=PROD # or UAT for staging sandbox

# ------------------------------------------------------------------------------
# 5. BACKUP & ARCHIVE DIRECTORY
# ------------------------------------------------------------------------------
BACKUP_STORAGE_PATH=./.data/backups
